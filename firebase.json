{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/consultation",
        "destination": "/consultation.html"
      },
      {
        "source": "/webinars",
        "destination": "/webinars.html"
      },
      {
        "source": "/resume",
        "destination": "/resume.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}